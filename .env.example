# Shard Cloud exposes only the public HTTP service on port 80.
PORT=80
HOST=0.0.0.0

# Leave empty for no extra login layer when Shard already protects the app.
# Set this to use code-server password authentication.
CODE_SERVER_PASSWORD=

# code-server proxies forwarded development ports through the same port-80 service.
VSCODE_PROXY_URI=./proxy/{{port}}/
